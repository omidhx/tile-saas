# DOMAIN از .env می‌آید. دامنه‌ی واقعی: گواهی Let's Encrypt.
# localhost یا IP: گواهی داخلی Caddy که مرورگر به آن هشدار می‌دهد؛ فقط برای تست.
#
# Caddy هدرهای X-Forwarded-For و X-Forwarded-Proto ارسالی کلاینت را خودش بازنویسی می‌کند
# و اپ سقف درخواست و HSTS را از همین‌ها می‌خواند. هدرهای امنیتی دیگر را خود اپ می‌گذارد.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
	log {
		output stdout
		format console
	}
}
