# =============================================================================
# .env.example — نمونه‌ی متغیرهای محیطی
# =============================================================================
# این فایل را به web/.env کپی و مقادیر را با مقادیر واقعی پر کنید.
# web/.env هرگز در git commit نمی‌شود (در .gitignore ریشه است).
# =============================================================================

# ----- دیتابیس -----
# در development با docker-compose، این مقدار پیش‌فرض را بگذارید:
DATABASE_URL=postgresql://tile_app:change-me-in-prod@localhost:5432/tile_saas
# در production: حتماً رمزِ قوی و کاربرِ non-superuser (نگاه کنید به docs/GO_LIVE.md)

# نقشِ DB — non-superuser حیاتی است (RLS با superuser بایپس می‌شود)
POSTGRES_USER=tile_app
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=tile_saas

# ----- احراز هویت -----
# حداقل ۳۲ کاراکتر. تولید: openssl rand -base64 32
AUTH_SECRET=replace-with-32-char-random-string-min

# ----- Rate limit -----
# memory: برای تک-instance (پیش‌فرض، ساده)
# postgres: برای multi-instance (با چند process/container) — نیاز به migration 0003
RATE_LIMIT_BACKEND=memory

# ----- Sentry (اختیاری) -----
# خالی = Sentry غیرفعال. در production برای tracking خطاها توصیه می‌شود.
SENTRY_DSN=

# ----- Port -----
WEB_PORT=3000

# ----- SMS Provider (برای تست، production باید kavenegar/ippanel/melipayamak/sms.ir/farazsms باشد) -----
# این از tenant-level کانفیگ در UI override می‌شود. این فقط fallback است.
SMS_PROVIDER=log

# ----- Email Provider (اختیاری — پیش‌فرض: log) -----
# برای بازیابی رمز از طریق ایمیل. فعلاً فقط log چاپ می‌کند.
EMAIL_PROVIDER=log

# ----- Bale Provider (اختیاری — پیش‌فرض: log) -----
# برای اعلان‌های بله. فعلاً فقط log چاپ می‌کند.
BALE_PROVIDER=log

# ----- Debug (اختیاری) -----
# اگر ست شود، NOTICEهای PostgreSQL در لاگ چاپ می‌شوند (برای دیباگ).
# در production ست نکنید — فقط نویز اضافه می‌کند.
# DEBUG_PG_NOTICE=1

# =============================================================================
# Phase 8 — Backup & Restore
# =============================================================================
# این متغیرها برایِ scripts/backup-db.sh، scripts/restore-db.sh و
# scripts/cleanup-old-backups.sh لازم هستند. در محیطِ development نیازی به
# ست کردنِ آن‌ها نیست ( اسکریپت‌ها خطا می‌دهند). در production حتماً ست کنید.
# =============================================================================

# Passphrase برایِ GPG symmetric encryption.
# ⚠️ اگر این را گم کنید، همه‌ی بکاپ‌ها قابلِ بازیابی نیستند.
# تولید: openssl rand -base64 32
# حداقل ۳۲ کاراکتر.
BACKUP_GPG_PASSPHRASE=replace-with-strong-passphrase-min-32-chars

# (اختیاری) rsync target برایِ off-site copy.
# اگر ست نشود، فقط local ذخیره می‌شود (با warning در لاگ).
# مثال‌ها:
#   user@backup.example.com:/backups/tile-saas/
#   /mnt/nas/tile-saas-backups/
BACKUP_OFFSITE_TARGET=

# (اختیاری) SSH key برایِ rsync (اگر target نیاز دارد).
# مسیرِ absolute. پیش‌فرض: کلیدِ default SSH.
BACKUP_OFFSITE_SSH_KEY=

# (اختیاری) Retention policy به روز. پیش‌فرض: ۳۰.
# کمتر از ۷ مجاز نیست (cleanup script رد می‌کند).
BACKUP_RETENTION_DAYS=30

# (اختیاری — معمولاً نیازی به تغییر نیست) مسیرِ فایلِ status در container.
# در docker-compose به /app/backups-status mount شده. فقط برایِ تست یا
# environments غیرِ استاندارد override کنید.
# BACKUP_STATUS_PATH=/app/backups-status/backup-status.json
