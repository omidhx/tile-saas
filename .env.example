# نمونه‌ی .env برای docker-compose.yml. فایل واقعی را scripts/init-env.sh با رمزهای تصادفی می‌سازد.
# برای توسعه‌ی محلی بدون Docker فقط web/.env با DATABASE_URL و AUTH_SECRET لازم است.

# دامنه‌ی سایت. برای تست بدون دامنه: IP سرور یا localhost.
DOMAIN=example.com

# نسخه‌ی ایمیج که scripts/release.sh ساخته است.
IMAGE_TAG=local

# superuser: فقط migrate و بکاپ. اپ هرگز با این وصل نمی‌شود.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
# نقش اپ و workerها زیر RLS. فقط hex؛ این رمز داخل URL اتصال قرار می‌گیرد.
APP_USER_PASSWORD=replace-with-openssl-rand-hex-32

# امضای نشست و رمزنگاری کلیدهای پیامک. عوض کردنش همه را خارج می‌کند و کلیدهای پیامک را باطل.
AUTH_SECRET=replace-with-openssl-rand-hex-32

# رمز بکاپ‌ها. گم شود، هیچ بکاپی باز نمی‌شود: جایی بیرون از سرور نگهش دارید. بعد از عوض کردن، رمز قبلی را هم نگه دارید.
BACKUP_GPG_PASSPHRASE=replace-with-openssl-rand-hex-32
# مقصد rsync برای کپی بیرون از سرور، مثل user@host:/backups/tile-saas/. خالی یعنی فقط روی همین سرور.
BACKUP_OFFSITE_TARGET=
BACKUP_OFFSITE_SSH_KEY=
BACKUP_RETENTION_DAYS=30

# اختیاری
SENTRY_DSN=
# log یعنی پیامک واقعی فرستاده نمی‌شود؛ پنل هر کارخانه از «تنظیمات» وصل می‌شود.
SMS_PROVIDER=log
RATE_LIMIT_BACKEND=postgres
