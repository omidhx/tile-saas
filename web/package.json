{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --env-file=.env.test --import tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:e2e": "next build && playwright test",
    "db:pull": "drizzle-kit pull",
    "seed:dev": "node --env-file-if-exists=.env --import tsx scripts/seed-dev.ts",
    "worker:expire": "node --env-file-if-exists=.env --import tsx scripts/expire.ts",
    "worker:outbox": "node --env-file-if-exists=.env --import tsx scripts/outbox.ts",
    "cleanup:uploads": "node --env-file-if-exists=.env --import tsx scripts/cleanup-orphan-uploads.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "lint": "eslint .",
    "build:scripts": "esbuild scripts/expire.ts scripts/outbox.ts scripts/housekeeping.ts scripts/migrate.ts scripts/create-admin.ts --bundle --platform=node --target=node22 --outdir=dist-scripts --log-level=warning"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@sentry/nextjs": "^10.78.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "next": "^16.4.5",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.25.12",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "fast-uri": "^3.1.5"
  }
}
