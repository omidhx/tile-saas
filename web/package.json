{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --env-file=.env.test --import tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:ci": "find src -name '*.test.ts' -print0 | xargs -0 node --env-file=.env.test --import tsx --test --test-concurrency=1",
    "test:e2e": "playwright test",
    "db:pull": "drizzle-kit pull",
    "seed:dev": "node --env-file=.env --import tsx scripts/seed-dev.ts",
    "worker:expire": "node --env-file-if-exists=.env --import tsx scripts/expire.ts",
    "worker:outbox": "node --env-file-if-exists=.env --import tsx scripts/outbox.ts",
    "cleanup:uploads": "node --env-file-if-exists=.env --import tsx scripts/cleanup-orphan-uploads.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx ../db/migrations/apply.ts",
    "test:migration": "node --import tsx scripts/test-migration-0004.ts"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@sentry/nextjs": "^10.69.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "next": "^16.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "fast-uri": "^3.1.5"
  }
}
