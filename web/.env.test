# پایگاه‌داده‌ی جداگانه‌ی تست — این فایل عمداً کامیت می‌شود (هیچ رازی ندارد).
#
# تست‌ها `DROP SCHEMA public CASCADE` می‌زنند و نقش می‌سازند، پس کلاستر تست از کلاستر توسعه جداست:
#   docker run -d --name tile_test_pg -p 127.0.0.1:55434:5432 -e POSTGRES_PASSWORD=test_admin_pw -e POSTGRES_DB=tile_test postgres:16-alpine
#
# DATABASE_URL نقش محدودی است که کد محصول با آن اجرا می‌شود (RLS فعال).
# TEST_ADMIN_DATABASE_URL فقط برای بازسازی schema و seed تست‌هاست.
# متغیرهای محیطی مقدارهای این فایل را override می‌کنند (در CI همین کار انجام می‌شود).
DATABASE_URL=postgres://app_user:test_app_pw@localhost:55434/tile_test
TEST_ADMIN_DATABASE_URL=postgres://postgres:test_admin_pw@localhost:55434/tile_test

# رازِ واقعی نیست، فقط ۳۲+ کاراکترِ ثابت برای تست — secretBox.ts (رمزنگاریِ کلیدهای پیامکی) بدونش خطا می‌دهد.
AUTH_SECRET=0000000000000000000000000000000000_test_only
